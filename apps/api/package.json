{
  "name": "@aaa/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
