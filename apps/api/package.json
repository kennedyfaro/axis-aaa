    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@node-rs/argon2": "2.2.2",
    "@prisma/client": "6.19.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "dotenv": "16.6.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "otplib": "12.0.1",
    "rate-limiter-flexible": "11.2.3",
