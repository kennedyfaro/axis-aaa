# Copie para .env e troque todos os valores.
POSTGRES_USER=aaa
POSTGRES_PASSWORD=troque-esta-senha
POSTGRES_DB=aaa_manager

# Senhas dos papéis de runtime (gere com: openssl rand -hex 24)
POSTGRES_APP_PASSWORD=troque-esta-senha-app
POSTGRES_WORKER_PASSWORD=troque-esta-senha-worker
POSTGRES_RADIUS_PASSWORD=troque-esta-senha-radius

# Segredo de assinatura do access token. Gere com: openssl rand -base64 48
JWT_ACCESS_SECRET=troque-esta-chave
# Claims validadas no access token.
JWT_ISSUER=axis-aaa
JWT_AUDIENCE=axis-panel
# Compara o IP do refresh token (desative apenas em redes com CGNAT).
REFRESH_BIND_IP=true

# Host público usado pelo nginx de produção no redirect e no server_name.
PUBLIC_HOST=localhost

# Chave AES-256-GCM para segredos de NAS. Gere com: openssl rand -hex 32
ENCRYPTION_KEY=troque-esta-chave-hex-64

# Em producao com TLS, defina true. No compose HTTP local, false.
COOKIE_SECURE=false
CORS_ORIGINS=http://localhost:8080
# Swagger/OpenAPI desabilitado em produção por padrão.
ENABLE_API_DOCS=false

# Chave de criptografia dos backups (AES-256-CBC/PBKDF2).
# Gere com: openssl rand -hex 32 e guarde fora do host dos backups.
BACKUP_ENCRYPTION_KEY=troque-esta-chave-de-backup

# Habilita o comando de emergência mfa-code (false por padrão).
MFA_CODE_ALLOW=false

# Permite rodar o seed destrutivo em NODE_ENV=production (NÃO use em produção).
SEED_ALLOW_DESTRUCTIVE=false

# Segredo compartilhado do cliente local radtest do FreeRADIUS.
# Gere com: openssl rand -base64 36 (mínimo 16 caracteres).
RADIUS_CLIENT_SECRET=troque-este-segredo-com-32-ou-mais-caracteres

# Exige Message-Authenticator nos NAS (mitiga Blast-RADIUS).
# true = recomendado; false = compatibilidade com NAS antigos.
RADIUS_REQUIRE_MA=true

# Habilita um único NAS curinga 0.0.0.0/0. Desabilitado por padrão:
# cada NAS deve ser cadastrado com o IP exato.
RADIUS_ALLOW_WILDCARD_NAS=false

# IP de gerência para publicar UDP 1812/1813. Deixe 0.0.0.0 apenas
# enquanto o firewall do host restringir o acesso às redes dos NAS.
RADIUS_BIND_IP=0.0.0.0

# CoA/Disconnect (RFC 5176) enviado pela API ao NAS.
RADIUS_COA_PORT=3799
RADIUS_COA_TIMEOUT_MS=2000

# Bootstrap do primeiro administrador. Execute:
# docker compose --profile tools run --rm bootstrap
BOOTSTRAP_ADMIN_NAME="Debug"
BOOTSTRAP_ADMIN_EMAIL=debug@aaa.local
BOOTSTRAP_ADMIN_PASSWORD=troque-por-uma-senha-forte
# Opcional. Se vazio, o bootstrap grava bootstrap/totp.txt (modo 600)
# e mostra apenas o caminho (nunca imprime o segredo no console).
BOOTSTRAP_ADMIN_TOTP_SECRET=
BOOTSTRAP_TOTP_OUTPUT=/bootstrap/totp.txt

# Desenvolvimento local fora do Docker:
# DATABASE_URL=postgresql://aaa:senha@127.0.0.1:5432/aaa_manager?schema=public
# REDIS_URL=redis://127.0.0.1:6379
